{
  "name": "marker-inventory",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "build:pages": "vite build --base=/marker-inventory/",
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "postinstall": "node scripts/patch-react-pageflip-enhanced.cjs",
    "start:server": "node dist-server/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "express": "^5.2.1",
    "lucide-react": "0.487.0",
    "multer": "^2.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-pageflip-enhanced": "^2.2.3",
    "react-router": "^7.18.2",
    "recharts": "2.15.2",
    "roughjs": "^4.6.6",
    "tailwind-merge": "3.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "4.1.12",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "^29.1.1",
    "openskills": "^1.5.0",
    "tailwindcss": "4.1.12",
    "tsx": "^4.23.12",
    "typescript": "5.7.2",
    "vite": "6.3.5",
    "vitest": "^4.1.10"
  }
}
